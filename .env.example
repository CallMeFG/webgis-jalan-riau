# Salin file ini menjadi .env lalu isi nilainya.
# Sumber data: "static" = file GeoJSON di public/data (tanpa internet ke Supabase)
#              "supabase" = ambil dari database Supabase (diisi di langkah 10)
VITE_DATA_MODE=static

# Diisi setelah project Supabase dibuat (Project Settings > API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
